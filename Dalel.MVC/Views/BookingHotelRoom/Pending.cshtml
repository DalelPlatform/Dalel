@model List<Dalel.ViewModels.BookingHotelRoomDetails>
<h2>Agency Pending Documents</h2>
@foreach (var book in Model)
{
    <div>
        <p>@book.Price</p>
        <p>@book.Guests</p>
        <p>@book.NumberOfGuests</p>
        <p>@book.Checkin</p>
        <p>@book.Checkout</p>
        <p>@book.NumberOfGuests</p>
        <form method="post" asp-action="Accept"
              asp-controller="BookingHotelRoom" asp-route-id="@book.Id">
            <button type="submit">✅ Accept</button>
        </form>

        <form method="post" asp-action="Reject"
              asp-controller="BookingHotelRoom" asp-route-id="@book.Id">
            <button type="submit">❌ Reject</button>
        </form>
    </div>
}
@model List<Dalel.ViewModels.BookingVehicleDetailsViewModel>
<h2>Agency Pending bookuments</h2>
@foreach (var book in Model)
{
    <div>
        <p><strong>Type:</strong> @book.ClientName</p>
        <p><strong>File:</strong> @book.ClientEmail</p>

        <form method="post" asp-action="Accept"
              asp-controller="BookingVehicle" asp-route-id="@book.Id">
            <button type="submit">✅ Accept</button>
        </form>

        <form method="post" asp-action="Reject"
              asp-controller="BookingVehicle" asp-route-id="@book.Id">
            <button type="submit">❌ Reject</button>
        </form>
    </div>
}
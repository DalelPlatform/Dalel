@{
    Layout = "Dashboard";
}

@model Dalel.ViewModels.HomeServices.CategoryServices.CategoryServicesDetailsVM
<h2>Category Details</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div>
    <p><strong>Name:</strong> @Model.Name</p>
    <p><strong>Image URL:</strong> @Model.ImageUrl</p>
    <p><strong>Description:</strong> @Model.Description</p>
    <p><strong>Service Providers Count:</strong> @Model.ServiceProvidersCount</p>
</div>
<a asp-action="Index">Back to List</a>
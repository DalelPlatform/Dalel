@{
    Layout = "Dashboard";
}
@using Models.HomeService;
@model List<CategoryServices>;

@* @section styles { *@
@*     <style> *@
@*         .test { *@
@*             color: aqua; *@
@*         } *@
@*     </style> *@
@* } *@


<h1 class="test">category List</h1>


<table class="table">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">ID</th>
            <th scope="col">Name</th>
            <th scope="col">Description</th>
            <th scope="col">Image</th>
            <th scope="col">
                Actions

            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var caterogy in Model)
        {
            <tr>
                <th scope="row">@caterogy.Id</th>
                <td colspan="2">@caterogy.Name</td>
                <td colspan="2">@caterogy.Description</td>
                <td colspan="2">@caterogy.Image</td>

                <td>
                    <a asp-action="edit" asp-controller="CategoryServices" asp-route-Id="@caterogy.Id" asp-route-Name="tttt">Edit </a>
                </td>
                <td>
                    <a asp-action="delete" asp-controller="CategoryServices" asp-route-Id="@caterogy.Id" asp-route-Name="tttt">Delete </a>
                </td>
            </tr>

        }
    </tbody>
</table>


@{
    Layout = "Dashboard";
}
@using Models.HomeService;
@model CategoryServices



<h1>Add New Category</h1>

<form asp-action="add" asp-controller="CategoryServices" method="post" enctype="multipart/form-data">
    @* <div class="mb-3"> *@
    @*     <label class="form-label" asp-for="Id"></label> *@
    @*     <input class="form-control" asp-for="Id" /> *@
    @*     <span class="text-danger" asp-validation-for="Id"></span> *@
    @* </div> *@
    <div class="mb-3">
        <label class="form-label" asp-for="Name"></label>
        <textarea class="form-control" asp-for="Name"></textarea>
        <span class="text-danger" asp-validation-for="Name"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Description"></label>
        <textarea class="form-control" asp-for="Description"></textarea>
        <span class="text-danger" asp-validation-for="Description"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Image"></label>
        <textarea class="form-control" asp-for="Image"></textarea>
        <span class="text-danger" asp-validation-for="Image"></span>
    </div>
    <input class="btn btn-primary" type="submit" value="Add New Category" />
</form>
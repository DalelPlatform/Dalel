@model List<Dalel.ViewModels.RestaurantReservationDetailsVM>
<h2>Agency Pending RestaurantReservation</h2>
@foreach (var book in Model)
{
    <div>
        <p>@book.RestaurantName</p>
        <form method="post" asp-action="Accept"
              asp-controller="RestaurantReservation" asp-route-id="@book.Id">
            <button type="submit">✅ Accept</button>
        </form>

        <form method="post" asp-action="Reject"
              asp-controller="RestaurantReservation" asp-route-id="@book.Id">
            <button type="submit">❌ Reject</button>
        </form>
    </div>
}
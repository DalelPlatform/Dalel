@{
    Layout = "Dashboard";
}

@model Dalel.ViewModels.HomeServices.CategoryServices.CategoryServicesDetailsVM
<h2>Category Details</h2>

@if (TempData?["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}


<div>
    <p><strong>Name:</strong> @Model.Name</p>
    <p><strong>Image URL:</strong> @Model.Image</p>
    <p><strong>Description:</strong> @Model.Description</p>
    <p><strong>Service Providers Count:</strong> @Model.ServiceProviderCount</p>
</div>
<a asp-controller="Category" asp-action="Details">Back to List</a>
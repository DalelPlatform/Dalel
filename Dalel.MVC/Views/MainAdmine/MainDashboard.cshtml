
<h2>Pending Requests</h2>

@model Dalel.ViewModels.AdminDashboardViewModel
@foreach (var request in Model.Documents)
{
   
    <div>
        <p>Count: @(Model.Documents?.Count ?? 0)</p>
        <p>@request.DocumentType</p>
        <form method="post" action="@Url.Action("AcceptRequest", new { id = request.Id, requestType = "Agency" })">
            <button type="submit">Accept</button>
        </form>
        <form method="post" action="@Url.Action("RejectRequest", new { id = request.Id, requestType = "Agency" })">
            <button type="submit">Reject</button>
        </form>
    </div>
}
